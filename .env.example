# =============================================================================
# Save Shop Backend Environment Variables
# =============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development
DEBUG=True

# Database URL
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./save_shop.db
# For Production / Docker Deployment (PostgreSQL with asyncpg or psycopg2):
# DATABASE_URL=postgresql+asyncpg://inventory_user:your-secure-password@db:5432/saveshop_db

# JWT Secret Key (generate a secure random 32+ char string in production)
SECRET_KEY=super-secret-save-shop-development-key-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google SSO Configuration
GOOGLE_SSO_ENABLED=True
# Put your Google OAuth 2.0 Client ID here (matches EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in Save-shop/.env)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated or JSON list of additional allowed client IDs (e.g. for Android / iOS native apps)
GOOGLE_ALLOWED_CLIENT_IDS=["your-google-android-client-id.apps.googleusercontent.com"]

# Users with these email addresses will automatically receive the ADMIN role on sign-in
ADMIN_EMAILS=["admin@saveshop.com", "your-email@gmail.com"]

# Direct login without SSO (keep False for production security; only True for automated tests or local debugging)
ENABLE_DEV_DIRECT_LOGIN=False
