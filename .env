# =============================================================================
# Save Shop Backend Environment Variables
# =============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/saveshop_db"

# JWT Secret Key (generate a secure random 32+ char string in production)
SECRET_KEY=super-secret-save-shop-development-key-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google SSO Configuration
GOOGLE_SSO_ENABLED=True
# Put your Google OAuth 2.0 Client ID here (matches EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in Save-shop/.env)
GOOGLE_CLIENT_ID=898498745806-g40fimuhq99o7aohltn4qqinpvog31d5.apps.googleusercontent.com

# Comma-separated list of additional allowed client IDs (e.g. for Android / iOS native apps)
GOOGLE_ALLOWED_CLIENT_IDS=["898498745806-gnrm36ifk3qoek9et2ej5o6ajrrc1bbm.apps.googleusercontent.com"]

# Users with these email addresses will automatically receive the ADMIN role on sign-in
ADMIN_EMAILS=["akashbapibag9@gmail.com"]

# Direct login without SSO (keep False for production security; only True for automated tests)
ENABLE_DEV_DIRECT_LOGIN=False
