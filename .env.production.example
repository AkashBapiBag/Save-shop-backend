# =============================================================================
# Save Shop Backend Production Environment Variables (Example)
# =============================================================================
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Save Shop Management System API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection
DATABASE_URL=postgresql+psycopg2://saveshop_user:your-secure-password@127.0.0.1:6432/saveshop_db

# Security & Tokens
SECRET_KEY=generate-a-secure-random-32-char-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google SSO Configuration
GOOGLE_SSO_ENABLED=True
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=["your-google-android-client-id.apps.googleusercontent.com"]
ADMIN_EMAILS=["akashbapibag9@gmail.com", "mysaveshop2025@gmail.com"]
ENABLE_DEV_DIRECT_LOGIN=False

# Allowed CORS Origins for Production
CORS_ORIGINS=["https://mysaveshop.online", "https://www.mysaveshop.online", "https://api.mysaveshop.online"]
